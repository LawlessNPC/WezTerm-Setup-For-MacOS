#!/usr/bin/env python3
"""claude-tasks: a WezTerm panel for Claude Code's background tasks.

One panel per WezTerm tab, docked to the Claude pane, in two shapes:
- a compact strip along the bottom while nothing runs (rows only, so Claude's
  pane keeps its width and the built-in diff panel, which needs >= 144
  columns, keeps opening), and
- a full panel while tasks run: on the right when Claude still keeps
  MIN_CLAUDE_COLS columns, otherwise taller along the bottom.
It switches shape on its own, focuses on the Claude session that opened it
(`a` toggles every session), and closes when the Claude pane closes.

    claude-tasks                   the panel, all sessions; stays until q
    claude-tasks --manual --pane N the same, docked to pane N (Cmd+Shift+B)
    claude-tasks --strip --pane N  the idle strip; widens into --auto when a
                                   task starts
    claude-tasks --auto --pane N   the full panel; shrinks back to the strip
                                   once nothing is running
    claude-tasks --session-start   SessionStart hook: opens the strip beside
                                   the Claude pane if its tab has no panel
    claude-tasks --hook            PostToolUse hook: opens the full panel when
                                   a background task starts and the tab has no
                                   panel (a strip upgrades itself)
    claude-tasks --list            one-shot plain listing (for debugging)

Hooks run in Claude's environment. Inside tmux, $WEZTERM_PANE is whichever
pane started the tmux server, so the Claude pane is found by mapping
$TMUX_PANE -> its tmux session's attached client tty -> the WezTerm pane on
that tty.

Where the facts come from:
- Claude Code writes each background shell's output to
  $TMPDIR-ish /private/tmp/claude-<uid>/<project>/<session>/tasks/<id>.output and
  appends "[exited with code N]" (or "[killed]") when it ends. While it runs, its
  shell holds that file open, so `lsof` says which tasks are alive and their pids.
- Subagents get <id>.output as a symlink to their transcript; they are done once
  the parent session's transcript carries a <task-notification> for that id.
- Descriptions and commands come from the session transcript
  (~/.claude/projects/<project>/<session>.jsonl), read incrementally.
- "% left" is an estimate: elapsed time against the median of the last five
  successful runs of the same command (or the sum of its parts, e.g.
  `make check` + `make test-watch`), measured from finished tasks' output files.

Python 3.9 compatible (the system python3), stdlib only.
"""
import calendar
import glob
import json
import os
import re
import select
import signal
import statistics
import subprocess
import sys
import termios
import time
import tty

UID = os.getuid()
TASK_GLOB = "/private/tmp/claude-%d/*/*/tasks/*.output" % UID
PROJECTS = os.path.expanduser("~/.claude/projects")
STATE_DIR = os.path.expanduser("~/.local/state/claude-tasks")
DISMISSED = os.path.join(STATE_DIR, "dismissed.json")

REFRESH = 2.0            # seconds between redraws
GRACE = 8.0              # --auto: seconds the final state stays up before shrinking
RECENT = 24 * 3600       # finished/stale tasks older than this are not listed
HISTORY_AGE = 30 * 86400 # finished tasks younger than this feed the estimates
DONE_FADE = 180          # finished tasks drop off the list after this long
AGENT_IDLE_STALE = 3600  # an agent with no completion and no writes this long is stale
PANE_CHECK = 5           # scans between checks that the Claude pane still exists
RESUME_SLACK = 10        # agent log writes this long after its notification mean it was resumed

STRIP_ROWS = 5           # the idle strip under the Claude pane
PANEL_COLS = 60          # the full panel's width on the right
PANEL_ROWS = 14          # the full panel's height when the window is too narrow
MIN_CLAUDE_COLS = 150    # Claude's diff panel needs >= 144 columns; keep a margin

WEZTERM_BINS = ("/opt/homebrew/bin/wezterm", "/usr/local/bin/wezterm",
                "/Applications/WezTerm.app/Contents/MacOS/wezterm")
TMUX_BINS = ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux")

EXIT_RE = re.compile(r"\[exited with code (-?\d+)\]\s*$")
BG_RE = re.compile(r"Command running in background with ID: ([A-Za-z0-9]+)")
AGENT_RE = re.compile(r"agentId: ([A-Za-z0-9]+)")
DETACHED = "[process exited while detached"
NOTE_RE = re.compile(r"<task-id>([A-Za-z0-9]+)</task-id>.*?<status>(\w+)</status>", re.S)
RESUME_RE = re.compile(r'"resumedAgentId"\s*:\s*"([A-Za-z0-9]+)"')
STEP_RE = re.compile(
    r"\bmake(?:\s+-C\s+\S+)?\s+[A-Za-z][\w-]*"
    r"|\bxcodebuild\b[^;&|]*?-scheme\s+\S+[^;&|]*?\b(?:test|build|archive)\b"
    r"|\bswift\s+(?:build|test)\b"
    r"|\b(?:npm|pnpm|yarn)\s+(?:run\s+)?[\w:-]+"
    r"|\bcargo\s+\w+|\bpytest\b|\bgo\s+test\b"
)


# ---------------------------------------------------------------------------
# Command keys for the duration history

def steps(command):
    """The recognisable build/test steps of a command, in order."""
    out = []
    for m in STEP_RE.finditer(command or ""):
        s = re.sub(r"\s+", " ", m.group(0)).strip()
        s = re.sub(r"-destination\s+'[^']*'", "", s)
        s = re.sub(r"-derivedDataPath\s+\S+", "", s)
        s = re.sub(r"\s+", " ", s)
        out.append(s)
    return out


def command_key(command):
    """One key per kind of command: its steps, or the command with paths blanked."""
    st = steps(command)
    if st:
        return " ; ".join(st)
    c = re.sub(r"(?:^|&&|;)\s*cd\s+\S+\s*(?:&&|;)", " ", command or "")
    c = re.sub(r"\d?>>?\s*\S+", "", c)
    c = re.sub(r"(?:~|/)[^\s'\"]*", "<path>", c)
    return re.sub(r"\s+", " ", c).strip()[:160]


# ---------------------------------------------------------------------------
# Transcript reading (incremental)

class Transcript:
    """What one session transcript says about its background tasks."""

    def __init__(self, path):
        self.path = path
        self.offset = 0
        self.uses = {}      # tool_use_id -> {"description", "command", "kind"}
        self.task_use = {}  # task id -> tool_use_id
        self.notes = {}     # task id -> last notification status
        self.note_times = {}  # task id -> when that notification arrived (epoch)
        self.resumes = {}   # agent id -> when the session last resumed it (epoch)
        self.pending = {}   # foreground Bash tool_use_id -> description, until its result
        self.cwd = ""       # the folder the session started in, for its project label
        self.ts = None      # timestamp of the record being read

    def refresh(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return
        if size < self.offset:
            self.__init__(self.path)
        if size == self.offset:
            return
        with open(self.path, "rb") as f:
            f.seek(self.offset)
            data = f.read()
        end = data.rfind(b"\n")
        if end < 0:
            return
        self.offset += end + 1
        for raw in data[: end + 1].splitlines():
            if (b'"Bash"' not in raw and b'"tool_result"' not in raw
                    and b"run_in_background" not in raw and b'"Agent"' not in raw
                    and b"background with ID" not in raw and b"agentId:" not in raw
                    and b"task-notification" not in raw and b"resumedAgentId" not in raw):
                continue
            try:
                self.take(json.loads(raw))
            except ValueError:
                continue

    def take(self, rec):
        if not self.cwd and isinstance(rec.get("cwd"), str):
            self.cwd = rec["cwd"]
        self.ts = parse_ts(rec.get("timestamp"))
        msg = rec.get("message") or {}
        content = msg.get("content")
        if isinstance(content, str):
            self.take_text(content)
            return
        if not isinstance(content, list):
            # Notifications that arrive while Claude is busy are stored as queued
            # commands ("attachment" / "queue-operation" records), not messages.
            self.take_text(json.dumps(rec, ensure_ascii=False))
            return
        for block in content:
            if not isinstance(block, dict):
                continue
            t = block.get("type")
            if t == "tool_use":
                name, inp = block.get("name"), block.get("input") or {}
                if name == "Bash" and not inp.get("run_in_background"):
                    self.pending[block.get("id")] = inp.get("description") or "shell command"
                elif name == "Bash":
                    self.uses[block.get("id")] = {
                        "description": inp.get("description") or "",
                        "command": inp.get("command") or "", "kind": "shell"}
                elif name == "Agent":
                    self.uses[block.get("id")] = {
                        "description": inp.get("description") or "subagent",
                        "command": "", "kind": "agent"}
            elif t == "tool_result":
                text = block.get("content")
                if isinstance(text, list):
                    text = " ".join(b.get("text", "") for b in text if isinstance(b, dict))
                text = text or ""
                self.pending.pop(block.get("tool_use_id"), None)
                m = BG_RE.search(text) or AGENT_RE.search(text)
                if m:
                    self.task_use[m.group(1)] = block.get("tool_use_id")
                r = RESUME_RE.search(text)
                if r and self.ts is not None:
                    self.resumes[r.group(1)] = self.ts  # SendMessage woke a finished agent
            elif t == "text":
                self.take_text(block.get("text") or "")

    def take_text(self, text):
        if "<task-notification>" in text:
            for m in NOTE_RE.finditer(text):
                self.notes[m.group(1)] = m.group(2)
                if self.ts is not None:
                    self.note_times[m.group(1)] = self.ts

    def info(self, task_id):
        return self.uses.get(self.task_use.get(task_id), {})


# ---------------------------------------------------------------------------
# Task discovery

def parse_ts(ts):
    """'2026-10-21T17:39:03.123Z' -> epoch seconds, or None."""
    try:
        return calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
    except (TypeError, ValueError):
        return None


def agent_state(note, note_time, resumed_at, mtime, now):
    """A subagent's state from its last notification, a later resume, and its log.

    A finished agent can be woken again (SendMessage resumes it); its old
    notification then no longer applies. That shows as a resume recorded
    after the notification, or as its log still being written well after it."""
    if note and note_time is not None:
        if (resumed_at is not None and resumed_at > note_time) or mtime > note_time + RESUME_SLACK:
            note = None
    if note == "completed":
        return "done"
    if note in ("failed", "killed", "stopped"):
        return "failed" if note == "failed" else "killed"
    if now - mtime > AGENT_IDLE_STALE:
        return "stale"
    return "running"


def tail(path, n=4096):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - n))
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def last_line(text):
    for line in reversed(text.splitlines()):
        line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line).strip()
        if line and not EXIT_RE.match(line):
            return line
    return ""


def holders(paths):
    """{path: [pid, ...]} for the files some process has open."""
    if not paths:
        return {}
    try:
        out = subprocess.run(["lsof", "-F", "pn", "--"] + list(paths),
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    res, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid is not None:
            res.setdefault(os.path.realpath(line[1:]), []).append(pid)
    return res


class Board:
    def __init__(self):
        self.transcripts = {}
        self.dismissed = set(load_json(DISMISSED, []))
        self.history = {}   # key -> [(end_time, seconds)]
        self.seen_done = set()

    def transcript(self, project, session):
        path = os.path.join(PROJECTS, project, session + ".jsonl")
        t = self.transcripts.get(path)
        if t is None:
            t = self.transcripts[path] = Transcript(path)
        t.refresh()
        return t

    def scan(self):
        now = time.time()
        files, seen = [], {}
        for path in sorted(glob.glob(TASK_GLOB), key=lambda p: os.path.islink(p)):
            real = os.path.realpath(path)
            try:
                st = os.stat(real)
            except OSError:
                continue
            if now - st.st_mtime > HISTORY_AGE:
                continue
            agent = real.endswith(".jsonl")
            parts = path.split(os.sep)
            where = (parts[-4], parts[-3])
            if real in seen:
                seen[real][4].append(where)  # the same task, re-linked by a resumed session
                continue
            entry = (real, st, agent, st.st_mtime, [where])
            seen[real] = entry
            files.append(entry)

        open_candidates = []
        for path, st, link, mtime, _ in files:
            if not link:
                t = tail(path, 200)
                if not (EXIT_RE.search(t) or "[killed]" in t or DETACHED in t):
                    open_candidates.append(path)
        held = holders(open_candidates)

        tasks = []
        for path, st, link, mtime, places in files:
            name = os.path.basename(path)
            task_id = re.sub(r"^agent-|\.(output|jsonl)$", "", name)
            info, tr = {}, None
            for project, session in reversed(places):
                cand = self.transcript(project, session)
                if tr is None or cand.notes.get(task_id):
                    tr = cand
                if not info:
                    info = cand.info(task_id)
            project, session = places[-1]
            start = getattr(st, "st_birthtime", st.st_ctime)
            meta = agent_meta(path) if link else {}
            task = {"id": task_id, "project": project, "session": session,
                    "label": project_label(project, tr.cwd if tr else ""),
                    "path": path, "start": start, "end": None, "pids": [],
                    "kind": "agent" if link else "shell",
                    "agent_type": meta.get("agentType", ""),
                    "description": info.get("description") or meta.get("description") or task_id,
                    "command": info.get("command", ""), "detail": ""}
            if link:
                task["state"] = agent_state(tr.notes.get(task_id), tr.note_times.get(task_id),
                                            tr.resumes.get(task_id), mtime, now)
                if task["state"] != "running":
                    task["end"] = mtime
                task["detail"] = agent_detail(path)
            else:
                text = tail(path)
                m = EXIT_RE.search(text)
                if m:
                    task["state"] = "done" if m.group(1) == "0" else "failed"
                    task["code"] = int(m.group(1))
                    task["end"] = mtime
                elif "[killed]" in text:
                    task["state"], task["end"] = "killed", mtime
                elif DETACHED in text:
                    task["state"], task["end"] = "done", mtime
                elif path in held:
                    task["state"] = "running"
                    task["pids"] = held[path]
                else:
                    task["state"], task["end"] = "stale", mtime
                task["detail"] = last_line(text)
                if task["state"] == "done" and task["command"] and task_id not in self.seen_done:
                    self.seen_done.add(task_id)
                    self.history.setdefault(command_key(task["command"]), []).append(
                        (mtime, mtime - start))
            if task["kind"] == "shell" and not info:
                if task["state"] == "running" and tr is not None and tr.pending:
                    task["description"] = list(tr.pending.values())[-1]
                    task["foreground"] = True
                elif task["state"] == "running" and now - start < 5:
                    continue
                if task["state"] == "running" and now - start < 5:
                    continue
            tasks.append(task)

        shown = []
        for t in tasks:
            if t["state"] == "running":
                shown.append(t)
            elif t["state"] == "stale":
                if t["id"] not in self.dismissed and now - t["end"] < RECENT:
                    shown.append(t)
            elif now - (t["end"] or 0) < DONE_FADE:
                shown.append(t)
        shown.sort(key=lambda t: (t["state"] != "running", -t["start"]))
        return shown

    def estimate(self, command):
        """Expected seconds for a command, or None."""
        def median_of(key):
            runs = sorted(self.history.get(key, []))[-5:]
            return statistics.median(s for _, s in runs) if runs else None
        whole = median_of(command_key(command))
        if whole:
            return whole
        parts = steps(command)
        if len(parts) > 1:
            meds = [median_of(p) for p in parts]
            if all(meds):
                return sum(meds)
        return None

    def dismiss_stale(self, tasks):
        for t in tasks:
            if t["state"] == "stale":
                self.dismissed.add(t["id"])
        save_json(DISMISSED, sorted(self.dismissed))


DETAIL_KEYS = ("description", "file_path", "command", "url", "pattern", "query", "prompt", "path")


def describe_tool(block):
    """'Read: main.gd', 'WebFetch: https://…', or just the tool name."""
    name = block.get("name") or "?"
    inp = block.get("input") or {}
    for key in DETAIL_KEYS:
        val = inp.get(key)
        if isinstance(val, str) and val.strip():
            val = val.strip().splitlines()[0]
            if key == "file_path":
                val = os.path.basename(val)
            return "%s: %s" % (name, val)
    return name


def agent_detail(path):
    """What the subagent is doing now: its latest tool call, or thinking/writing."""
    for line in reversed(tail(path, 65536).splitlines()):
        if '"assistant"' not in line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") != "assistant":
            continue
        for b in reversed((rec.get("message") or {}).get("content") or []):
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_use":
                if "Handback" in (b.get("name") or ""):
                    return "handed back its report"  # the agent's final act
                return describe_tool(b)
            if b.get("type") == "text" and (b.get("text") or "").strip():
                return "writing: " + b["text"].strip().splitlines()[0]
            if b.get("type") == "thinking":
                return "thinking…"
    return ""


def agent_meta(path):
    """The agent's sidecar (agentType, description) next to its transcript."""
    if not path.endswith(".jsonl"):
        return {}
    meta = load_json(path[: -len(".jsonl")] + ".meta.json", {})
    return meta if isinstance(meta, dict) else {}


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(value, f)


# ---------------------------------------------------------------------------
# Killing

def kill_task(task):
    """SIGTERM the task's process groups; never Claude's own group."""
    mine = {os.getpgid(0)}
    for pid in task["pids"]:
        try:
            pgid = os.getpgid(pid)
            parent_pgid = os.getpgid(int(subprocess.run(
                ["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True,
                text=True).stdout.strip() or 1))
        except (OSError, ValueError):
            continue
        if pgid in mine or pgid == parent_pgid:
            os.kill(pid, signal.SIGTERM)  # shares a group with its parent: just it
        else:
            os.killpg(pgid, signal.SIGTERM)


# ---------------------------------------------------------------------------
# Drawing (plain ANSI; colours come from the terminal's palette)

RESET, BOLD, DIM, REV = "\x1b[0m", "\x1b[1m", "\x1b[2m", "\x1b[7m"
MAGENTA = "\x1b[35m"
COL = {"running": "\x1b[36m", "done": "\x1b[32m", "failed": "\x1b[31m",
       "killed": "\x1b[35m", "stale": "\x1b[33m"}
ICON = {"running": "●", "done": "✔", "failed": "✘", "killed": "■", "stale": "◌"}
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def fmt_dur(s):
    s = int(max(0, s))
    if s < 60:
        return "%ds" % s
    if s < 3600:
        return "%dm%02ds" % (s // 60, s % 60)
    return "%dh%02dm" % (s // 3600, (s % 3600) // 60)


CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def safe(text):
    """Text from transcripts and task output, with every control character
    (ESC above all) shown as '?', so nothing in it can drive the terminal:
    retitle the window, plant hyperlinks, or write the clipboard (OSC 52)."""
    return CONTROL_RE.sub("?", str(text).replace("\t", " "))


def clip(text, width):
    """Every string drawn on screen passes through here, so it is made safe here."""
    text = safe(text)
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def project_name(slug):
    """'-Users-me-repos-Momentum' -> 'repos-Momentum'; the home folder itself -> '~'.

    The slug flattens '/' to '-', so it can't tell 'hilltop-war' from
    'hilltop/war'; project_label prefers the session's real folder."""
    home = os.path.expanduser("~").replace("/", "-")
    if slug in (home, home + "-"):
        return "~"
    if slug.startswith(home + "-"):
        return slug[len(home) + 1:]
    return slug.lstrip("-") or "~"


def project_label(slug, cwd=""):
    """The session folder's name ('hilltop-war'), else a best guess from the slug."""
    if cwd:
        if os.path.realpath(cwd) == os.path.realpath(os.path.expanduser("~")):
            return "~"
        return os.path.basename(cwd.rstrip("/")) or "~"
    return project_name(slug)


def clock(epoch, seconds=False):
    """12-hour wall-clock time: '1:04 PM' (or '1:04:09 PM')."""
    return time.strftime("%I:%M:%S %p" if seconds else "%I:%M %p",
                         time.localtime(epoch)).lstrip("0")


def in_scope(tasks, session, show_all=False):
    """The tasks of one Claude session, or every task when show_all/no session."""
    if show_all or not session:
        return list(tasks)
    return [t for t in tasks if t.get("session") == session]


def busy(tasks):
    """Whether background work is running: background shells and subagents.
    Foreground commands are listed but don't widen or hold open the panel,
    so it doesn't jump around on every slow command."""
    return any(t["state"] == "running" and not t.get("foreground") for t in tasks)


def when(task, now):
    """'since 1:03 PM' while running; 'done 1:04 PM' (or failed/killed) after."""
    if task["state"] == "running":
        return "since " + clock(task["start"])
    word = {"done": "done", "failed": "failed", "killed": "killed"}.get(task["state"], "ended")
    return "%s %s" % (word, clock(task["end"] or now))


def header(tasks, width, scope, now):
    """' CLAUDE TASKS  2 running · this session            1:04 PM'"""
    running = sum(t["state"] == "running" for t in tasks)
    stale = sum(t["state"] == "stale" for t in tasks)
    head = " CLAUDE TASKS "
    summary = ("%d running" % running if running else "idle") \
        + (" · %d stale" % stale if stale else "") + (" · " + scope if scope else "")
    right = clock(now)
    summary = clip(summary, max(0, width - len(head) - len(right) - 3))
    pad = width - len(head) - 1 - len(summary) - len(right)
    return (BOLD + REV + clip(head, width) + RESET + " " + DIM + summary + RESET
            + " " * max(1, pad) + DIM + right + RESET)


def render(board, tasks, sel, width, height, frame, banner, scope=""):
    now = time.time()
    lines = [header(tasks, width, scope, now)]
    lines.append(DIM + "─" * width + RESET)
    if not tasks:
        lines.append(DIM + " nothing running" + RESET)
    bar_w = max(8, width - 22)
    for i, t in enumerate(tasks):
        c, st = COL[t["state"]], t["state"]
        icon = SPIN[frame % len(SPIN)] if st == "running" else ICON[st]
        elapsed = (t["end"] or now) - t["start"]
        right = fmt_dur(elapsed)
        title = clip(t["description"], width - len(right) - 4)
        pad = width - len(title) - len(right) - 3
        row = " %s %s%s%s" % (icon, title, " " * max(1, pad), right)
        lines.append((REV if i == sel else "") + c + row + RESET)
        if st == "running" and t["kind"] == "shell":
            exp = board.estimate(t["command"])
            if exp:
                frac = min(elapsed / exp, 0.99)
                fill = int(bar_w * frac)
                left = exp - elapsed
                tail_txt = ("%3d%% left ~%s" % (round(100 * (1 - frac)), fmt_dur(left))
                            if left > 0 else " overrunning")
                lines.append("   " + c + "▓" * fill + DIM + "░" * (bar_w - fill) + RESET
                             + " " + tail_txt)
            else:
                lines.append("   " + DIM + "no history yet · elapsed only" + RESET)
        elif st == "stale":
            lines.append("   " + COL["stale"] + "never finished; its shell is gone" + RESET)
        kind = (t.get("agent_type") or "agent") if t["kind"] == "agent" else ""
        meta = " · ".join(p for p in (t.get("label") or project_name(t["project"]), kind,
                                      "foreground" if t.get("foreground") else "",
                                      when(t, now)) if p)
        lines.append("   " + DIM + clip(meta, width - 3) + RESET)
        if t["detail"]:
            act = MAGENTA if st == "running" and t["kind"] == "agent" else DIM
            lines.append("   " + act + "↳ " + clip(t["detail"], width - 5) + RESET)
    lines = lines[: height - 2]
    while len(lines) < height - 2:
        lines.append("")
    lines.append(DIM + "─" * width + RESET)
    lines.append(banner or (DIM + clip(" j/k move  x kill  d clear stale  a all/this  q close", width) + RESET))
    sys.stdout.write("\x1b[H" + "\n".join(l + "\x1b[K" for l in lines) + "\x1b[J")
    sys.stdout.flush()


def render_strip(tasks, width, height, frame, scope=""):
    """The idle strip: a header and the most recent tasks, one line each."""
    now = time.time()
    lines = [header(tasks, width, scope, now)]
    if not tasks:
        lines.append(DIM + clip(" nothing running · this widens into the full panel while tasks run", width) + RESET)
    for t in tasks[: max(0, height - 1)]:
        st = t["state"]
        icon = SPIN[frame % len(SPIN)] if st == "running" else ICON[st]
        right = "%s · %s" % (when(t, now), fmt_dur((t["end"] or now) - t["start"]))
        title = clip(t["description"], max(0, width - len(right) - 5))
        pad = width - len(title) - len(right) - 3
        lines.append(COL[st] + " %s %s%s" % (icon, title, " " * max(1, pad)) + DIM + right + RESET)
    lines = lines[:height]
    while len(lines) < height:
        lines.append("")
    sys.stdout.write("\x1b[H" + "\n".join(l + "\x1b[K" for l in lines) + "\x1b[J")
    sys.stdout.flush()


# ---------------------------------------------------------------------------
# Panel

def panel(mode="manual", claude=None, session=None):
    """The panel loop. mode: 'manual' (stays until q), 'auto' (full panel that
    shrinks back to the strip when idle) or 'strip' (idle strip that widens
    into 'auto' when a task starts). claude: the Claude pane it is docked to."""
    os.makedirs(STATE_DIR, exist_ok=True)
    me = os.environ.get("WEZTERM_PANE")
    tab = None
    if claude is not None:
        info = pane_info(wez_panes(), claude)
        tab = info.get("tab_id") if info else None
        if tab is not None and me:
            register(tab, me, claude, session, mode)
    title = "claude-tasks" if mode != "strip" else "claude-tasks strip"
    sys.stdout.write("\x1b]0;%s\x07\x1b[?25l\x1b[?1049h" % title)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    board, sel, frame, scans = Board(), 0, 0, 0
    show_all = not session
    idle_since, confirm, banner = None, None, ""
    try:
        everything = board.scan()
        next_scan = time.time() + REFRESH
        while True:
            tasks = in_scope(everything, session, show_all)
            scope = "" if not session else ("all sessions" if show_all else "this session")
            size = os.get_terminal_size()
            sel = max(0, min(sel, len(tasks) - 1))
            if mode == "strip":
                render_strip(tasks, size.columns, size.lines, frame, scope)
            else:
                render(board, tasks, sel, size.columns, size.lines, frame, banner, scope)
            r, _, _ = select.select([sys.stdin], [], [], 0.15)
            frame += 1
            if r:
                ch = os.read(fd, 1).decode(errors="ignore")
                if confirm is not None:
                    if ch in "yY":
                        kill_task(confirm)
                        banner = COL["killed"] + " sent SIGTERM to " + clip(confirm["description"], 30) + RESET
                    else:
                        banner = ""
                    confirm = None
                elif ch == "q":
                    return
                elif ch == "a" and session:
                    show_all = not show_all
                elif ch in "j\x0e":
                    sel += 1
                elif ch in "k\x10":
                    sel -= 1
                elif ch == "d":
                    board.dismiss_stale(tasks)
                    next_scan = 0
                elif ch == "x" and tasks:
                    t = tasks[sel]
                    if t["state"] != "running":
                        banner = DIM + " not running" + RESET
                    elif t["kind"] == "agent":
                        banner = DIM + " agents stop from Claude (TaskStop)" + RESET
                    else:
                        confirm = t
                        banner = COL["failed"] + BOLD + " kill “%s”? y/n" % clip(t["description"], size.columns - 16) + RESET
            if time.time() < next_scan:
                continue
            everything = board.scan()
            next_scan = time.time() + REFRESH
            scans += 1
            if claude is None:
                # Undocked (plain --auto): close once idle, as before.
                if mode == "auto":
                    if busy(in_scope(everything, session)):
                        idle_since = None
                    elif idle_since is None:
                        idle_since = time.time()
                    elif time.time() - idle_since >= GRACE:
                        return
                continue
            if tab is not None and me:
                # A resumed or new Claude session in this tab re-targets the panel.
                st = load_json(tab_state(tab), {})
                if str(st.get("pane")) == str(me) and st.get("session") and st.get("session") != session:
                    session, show_all = st.get("session"), False
            if scans % PANE_CHECK == 0 and pane_info(wez_panes(), claude) is None:
                return  # the Claude pane closed; take the panel with it
            running = busy(in_scope(everything, session))
            if mode == "strip" and running:
                if open_panel(claude, "auto", session):
                    return  # the full panel took over
            elif mode == "auto":
                if running:
                    idle_since = None
                elif idle_since is None:
                    idle_since = time.time()
                elif time.time() - idle_since >= GRACE:
                    open_panel(claude, "strip", session)
                    return
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?1049l\x1b[?25h")
        sys.stdout.flush()
        if tab is not None and me:
            unregister(tab, me)


# ---------------------------------------------------------------------------
# WezTerm: finding the Claude pane, placing and tracking the panel

def first_bin(paths, fallback):
    return next((p for p in paths if os.path.exists(p)), fallback)


def wez(*args):
    """Run `wezterm cli ...`; stdout, or '' on any failure."""
    try:
        return subprocess.run([first_bin(WEZTERM_BINS, "wezterm"), "cli"] + list(args),
                              capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def wez_panes():
    try:
        panes = json.loads(wez("list", "--format", "json") or "[]")
    except ValueError:
        return []
    return panes if isinstance(panes, list) else []


def pane_info(panes, pane_id):
    for p in panes:
        if str(p.get("pane_id")) == str(pane_id):
            return p
    return None


def pane_for_tty(panes, tty_name):
    for p in panes:
        if tty_name and p.get("tty_name") == tty_name:
            return p.get("pane_id")
    return None


def claude_pane(panes, env=None):
    """The WezTerm pane showing this Claude session (hooks run in its environment)."""
    env = os.environ if env is None else env
    if env.get("TMUX_PANE"):
        tmux = first_bin(TMUX_BINS, "tmux")
        try:
            session = subprocess.run([tmux, "display-message", "-p", "-t", env["TMUX_PANE"],
                                      "#{session_name}"], capture_output=True, text=True,
                                     timeout=5).stdout.strip()
            ttys = subprocess.run([tmux, "list-clients", "-t", session, "-F", "#{client_tty}"],
                                  capture_output=True, text=True, timeout=5).stdout.split()
        except (OSError, subprocess.SubprocessError):
            ttys = []
        for t in ttys:
            pane = pane_for_tty(panes, t)
            if pane is not None:
                return pane
    if env.get("WEZTERM_PANE") and pane_info(panes, env["WEZTERM_PANE"]):
        return int(env["WEZTERM_PANE"])
    try:
        clients = json.loads(wez("list-clients", "--format", "json") or "[]")
        return clients[0].get("focused_pane_id") if clients else None
    except (ValueError, AttributeError):
        return None


def placement(cols, mode):
    """(direction, cells) for a panel beside a Claude pane `cols` wide.

    The strip and the narrow-window panel take rows, never columns, so Claude
    keeps its width and its diff panel (>= 144 columns) keeps opening."""
    if mode == "strip":
        return ("bottom", STRIP_ROWS)
    if cols - PANEL_COLS - 1 >= MIN_CLAUDE_COLS:
        return ("right", PANEL_COLS)
    return ("bottom", PANEL_ROWS)


def tab_state(tab):
    return os.path.join(STATE_DIR, "tab-%s.json" % tab)


def register(tab, pane, claude, session, mode):
    save_json(tab_state(tab), {"pane": int(pane), "claude_pane": int(claude),
                               "session": session or "", "mode": mode})


def unregister(tab, pane):
    """Forget this tab's panel, unless another panel already took over."""
    st = load_json(tab_state(tab), {})
    if str(st.get("pane")) == str(pane):
        try:
            os.remove(tab_state(tab))
        except OSError:
            pass


def live_panel(panes, tab):
    """This tab's registered panel, if its pane still exists in the tab."""
    st = load_json(tab_state(tab), {})
    info = pane_info(panes, st.get("pane"))
    return st if info and info.get("tab_id") == tab else None


def open_panel(claude, mode, session, panes=None):
    """Split a panel off the Claude pane; returns its pane id, or None."""
    panes = wez_panes() if panes is None else panes
    info = pane_info(panes, claude)
    if not info:
        return None
    direction, cells = placement((info.get("size") or {}).get("cols", 0), mode)
    args = ["split-pane", "--pane-id", str(claude), "--" + direction, "--cells", str(cells),
            "--", sys.executable, os.path.realpath(__file__), "--" + mode, "--pane", str(claude)]
    if session:
        args += ["--session", session]
    new = wez(*args).strip()
    if not new.isdigit():
        return None
    register(info.get("tab_id"), new, claude, session, mode)  # claim the tab before it starts
    wez("activate-pane", "--pane-id", str(claude))
    return int(new)


# ---------------------------------------------------------------------------
# Hooks

def read_event():
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return {}
    return event if isinstance(event, dict) else {}


def dock(event, mode):
    """Open `mode` beside this session's Claude pane unless its tab has a panel.
    A panel already there is pointed at this session instead."""
    panes = wez_panes()
    claude = claude_pane(panes)
    info = pane_info(panes, claude) if claude is not None else None
    if not info:
        return
    session = event.get("session_id") or ""
    st = live_panel(panes, info.get("tab_id"))
    if st:
        if session and st.get("session") != session:
            st["session"] = session
            save_json(tab_state(info.get("tab_id")), st)
        return  # an idle strip widens by itself within a couple of seconds
    open_panel(claude, mode, session, panes)


def hook():
    """PostToolUse: a background shell or subagent just started."""
    event = read_event()
    name = event.get("tool_name")
    inp = event.get("tool_input") or {}
    if name == "Bash" and not inp.get("run_in_background"):
        return
    if name not in ("Bash", "Agent"):
        return
    dock(event, "auto")


def session_start():
    """SessionStart: dock the idle strip under the Claude pane."""
    dock(read_event(), "strip")


def parse_args(argv):
    opts = {"mode": "manual", "pane": None, "session": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--auto", "--strip", "--manual", "--hook", "--session-start", "--list"):
            opts["mode"] = a[2:]
        elif a in ("--pane", "--session") and i + 1 < len(argv):
            opts[a[2:]] = argv[i + 1]
            i += 1
        i += 1
    return opts


def listing():
    board = Board()
    for t in board.scan():
        exp = board.estimate(t["command"]) if t["kind"] == "shell" else None
        print("%-8s %-6s %-18s %s%s" % (
            t["state"], t["kind"], safe(t["id"]), safe(t["description"]),
            "  (~%s expected)" % fmt_dur(exp) if exp else ""))


if __name__ == "__main__":
    opts = parse_args(sys.argv[1:])
    if opts["mode"] == "hook":
        hook()
    elif opts["mode"] == "session-start":
        session_start()
    elif opts["mode"] == "list":
        listing()
    else:
        panel(opts["mode"], opts["pane"], opts["session"])
