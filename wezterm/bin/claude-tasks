    pelipper ralts kirlia gardevoir surskit masquerain shroomish breloom
    slakoth vigoroth slaking nincada ninjask shedinja whismur loudred exploud
    makuhita hariyama azurill nosepass skitty delcatty sableye mawile aron
    lairon aggron meditite medicham electrike manectric plusle minun volbeat
    illumise roselia gulpin swalot carvanha sharpedo wailmer wailord numel
    camerupt torkoal spoink grumpig spinda trapinch vibrava flygon cacnea
    cacturne swablu altaria zangoose seviper lunatone solrock barboach whiscash
    corphish crawdaunt baltoy claydol lileep cradily anorith armaldo feebas
    milotic castform kecleon shuppet banette duskull dusclops tropius chimecho
    absol wynaut snorunt glalie spheal sealeo walrein clamperl huntail gorebyss
    relicanth luvdisc bagon shelgon salamence beldum metang metagross regirock
    regice registeel latias latios kyogre groudon rayquaza jirachi deoxys
""".split()

PNG_SIG = b"\x89PNG\r\n\x1a\n"

# The return to the ball, a step per SPRITE_TICK over the last RECALL_LEAD
# seconds before a finished task leaves the list: the Pokémon flashes, turns
# red and shrinks into the open ball, which closes and wobbles, then rests
# there until the row goes. Each step is (the Pokémon's size, or 0 once it is
# in; its tint; the ball's frame, or None; the ball's nudge in ball pixels).
BALL_CLOSED, BALL_OPEN = 0, 1
RECALL = (
    (1.0, "flash", None, 0),
    (1.0, "red", None, 0),
    (0.75, "red", BALL_OPEN, 0),
    (0.5, "red", BALL_OPEN, 0),
    (0.25, "red", BALL_OPEN, 0),
    (0, None, BALL_OPEN, 0),
    (0, None, BALL_CLOSED, 0),
    (0, None, BALL_CLOSED, -2),
    (0, None, BALL_CLOSED, 2),
    (0, None, BALL_CLOSED, 0),
)
TINTS = {"flash": ((255, 255, 255), 0.7), "red": ((255, 96, 96), 0.75)}
BALL = "ball"            # the Sprites key for the ball, beside the dex numbers


def sprite_for(task_id):
    """The task's national dex number, 1-386: the same on every redraw and restart."""
    return zlib.crc32(str(task_id).encode("utf-8")) % len(DEX_NAMES) + 1


def sprite_frame(task, now):
    """The party-menu bob while running; frame 0, standing still, once it has
    ended, as the game shows a fainted Pokémon."""
    return int(now / SPRITE_TICK) % 2 if task["state"] == "running" else 0


def recall_step(task, now):
    """The step of RECALL to draw, or None while the task isn't leaving. Only
    finished tasks fade out (a stale one stays until cleared), and the last
    step holds until the list drops the row."""
    if task["state"] not in ("done", "failed", "killed") or not task.get("end"):
        return None
    t = now - (task["end"] + DONE_FADE - RECALL_LEAD)
    return None if t < 0 else min(int(t / SPRITE_TICK), len(RECALL) - 1)


def sprite_scale(cell_w, cell_h):
    """The largest whole k (whole multiples keep pixel art crisp) at which any
    icon, cut to what it draws, fits the gutter beside 2 rows; 0 when nothing
    fits or the cell size is unknown. One k for all, so sizes stay as in-game."""
    if cell_w <= 0 or cell_h <= 0:
        return 0
    return min(GUTTER * cell_w // SHOWN_W, 2 * cell_h // SHOWN_H)


def cell_px(fd):
    """One cell's (width, height) in pixels, or (0, 0) when the terminal won't say."""
    try:
        rows, cols, xpx, ypx = struct.unpack(
            "HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
    except (OSError, ValueError):
        return (0, 0)
    return (xpx // cols, ypx // rows) if rows and cols else (0, 0)


def sprites_enabled(env=None):
    """Sprites need WezTerm: the iTerm2 image protocol plus its doNotMoveCursor."""
    env = os.environ if env is None else env
    return env.get("TERM_PROGRAM") == "WezTerm" and env.get("CLAUDE_TASKS_SPRITES") != "0"


def paeth(a, b, c):
    p = a + b - c
    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
    if pa <= pb and pa <= pc:
        return a
    return b if pb <= pc else c


def png_unfilter(raw, h, stride, bpp):
    """Undo PNG's per-row filters (None, Sub, Up, Average, Paeth). bpp is the
    filter's byte distance: 1 for bit depths below 8."""
    lines, prev = [], bytearray(stride)
    for y in range(h):
        at = y * (stride + 1)
        kind, line = raw[at], bytearray(raw[at + 1:at + 1 + stride])
        if kind > 4:
            raise ValueError("bad PNG filter %d" % kind)
        for x in range(stride if kind else 0):
            a = line[x - bpp] if x >= bpp else 0
            if kind == 1:
                line[x] = (line[x] + a) & 255
            elif kind == 2:
                line[x] = (line[x] + prev[x]) & 255
            elif kind == 3:
                line[x] = (line[x] + ((a + prev[x]) >> 1)) & 255
            else:
                c = prev[x - bpp] if x >= bpp else 0
                line[x] = (line[x] + paeth(a, prev[x], c)) & 255
        lines.append(line)
        prev = line
    return lines


def png_decode(data, clear=None):
    """(width, height, rows) of a PNG, each row its pixels as RGBA bytes.
    Covers the party icons (4bpp indexed, high nibble first; tRNS makes index
    0 transparent and may be shorter than PLTE) and png_encode's 8-bit RGBA.
    clear names a palette index to make transparent, for a sheet with no tRNS."""
    if data[:8] != PNG_SIG:
        raise ValueError("not a PNG")
    pos, ihdr, plte, trns, idat = 8, None, b"", b"", []
    while pos + 8 <= len(data):
        size, kind = struct.unpack(">I4s", data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + size]
        pos += size + 12
        if kind == b"IHDR":
            ihdr = struct.unpack(">IIBBBBB", body)
        elif kind == b"PLTE":
            plte = body
        elif kind == b"tRNS":
            trns = body
        elif kind == b"IDAT":
            idat.append(body)  # an image may split its data over several
        elif kind == b"IEND":
            break
    if ihdr is None:
        raise ValueError("no IHDR")
    w, h, depth, ctype, _, _, interlaced = ihdr
    if (interlaced or not (0 < w <= 256 and 0 < h <= 256)
            or (ctype, depth) not in ((3, 1), (3, 2), (3, 4), (3, 8), (6, 8))):
        raise ValueError("unsupported PNG")
    bits = depth if ctype == 3 else 32
    stride = (w * bits + 7) // 8
    raw = zlib.decompressobj().decompress(b"".join(idat), h * (stride + 1))
    if len(raw) < h * (stride + 1):
        raise ValueError("short PNG data")
    lines = png_unfilter(raw, h, stride, max(1, bits // 8))
    if ctype == 6:
        return w, h, [bytes(line) for line in lines]
    alpha = [trns[i] if i < len(trns) else 255 for i in range(len(plte) // 3)]
    if clear is not None and clear < len(alpha):
        alpha[clear] = 0
    pal = [plte[3 * i:3 * i + 3] + bytes([a]) for i, a in enumerate(alpha)]
    per, mask = 8 // depth, (1 << depth) - 1
    return w, h, [b"".join(pal[(line[x // per] >> (8 - depth * (x % per + 1))) & mask]
                           for x in range(w)) for line in lines]


def png_encode(rows):
    """An 8-bit RGBA PNG of rows (RGBA bytes each), every row filter 0."""
    def chunk(kind, body):
        return (struct.pack(">I", len(body)) + kind + body
                + struct.pack(">I", zlib.crc32(kind + body) & 0xffffffff))
    ihdr = struct.pack(">IIBBBBB", len(rows[0]) // 4, len(rows), 8, 6, 0, 0, 0)
    raw = b"".join(b"\0" + row for row in rows)
    return (PNG_SIG + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(raw, 9))
            + chunk(b"IEND", b""))


def png_scale(rows, k):
    """Nearest-neighbour enlargement: every pixel k wide, every row k tall."""
    out = []
    for row in rows:
        out += [b"".join(row[x:x + 4] * k for x in range(0, len(row), 4))] * k
    return out


def png_place(rows, k, w, h, dx=0):
    """rows enlarged k times and centred on a transparent w x h canvas,
    nudged dx pixels sideways."""
    rows = png_scale(rows, k)
    sw = len(rows[0]) // 4
    left, top = max(0, min(w - sw, (w - sw) // 2 + dx)), (h - len(rows)) // 2
    before, after, blank = b"\0" * 4 * left, b"\0" * 4 * (w - sw - left), b"\0" * 4 * w
    return [blank] * top + [before + r + after for r in rows] + [blank] * (h - top - len(rows))


def png_resize(rows, w, h):
    """Nearest-neighbour resize to w x h, for the shrink into the ball."""
    sw, sh = len(rows[0]) // 4, len(rows)
    return [b"".join(rows[y * sh // h][4 * (x * sw // w):4 * (x * sw // w) + 4] for x in range(w))
            for y in range(h)]


def png_tint(rows, rgb, amount):
    """rows with every visible pixel blended that far (0-1) towards rgb."""
    out = []
    for row in rows:
        px = bytearray(row)
        for i in range(0, len(px), 4):
            if px[i + 3]:
                for c in range(3):
                    px[i + c] += int((rgb[c] - px[i + c]) * amount)
        out.append(bytes(px))
    return out


def png_over(under, over):
    """over drawn on top of under, both the same size: its visible pixels win."""
    out = []
    for a, b in zip(under, over):
        row = bytearray(a)
        for i in range(0, len(b), 4):
            if b[i + 3]:
                row[i:i + 4] = b[i:i + 4]
        out.append(bytes(row))
    return out


def icon_frames(png):
    """A decoded party icon's frames: 32x32 each, stacked, frame 0 on top."""
    w, h, rows = png
    if w != ICON_PX or h < ICON_PX or h % ICON_PX:
        raise ValueError("not a party icon")
    return [rows[y:y + ICON_PX] for y in range(0, h, ICON_PX)]


def icon_crop(frames):
    """The frames cut to the box holding every visible pixel of any of them:
    one box for all, so the bob between frames still shows."""
    xs, ys = [], []
    for f in frames:
        for y, row in enumerate(f):
            seen = [x for x, alpha in enumerate(row[3::4]) if alpha]
            if seen:
                xs += seen
                ys.append(y)
    if not xs:
        return frames
    x0, x1, y0, y1 = min(xs), max(xs) + 1, min(ys), max(ys) + 1
    return [[row[4 * x0:4 * x1] for row in f[y0:y1]] for f in frames]


def ball_frames(png):
    """The Poké Ball sheet's first two frames, 16x16 each: closed, then open."""
    w, h, rows = png
    if w != BALL_PX or h < 2 * BALL_PX:
        raise ValueError("not a ball sheet")
    return [rows[:BALL_PX], rows[BALL_PX:2 * BALL_PX]]


def recall_png(mon, ball, step, k, w, h):
    """One step of RECALL on a w x h canvas, at scale k. mon is the Pokémon's
    frame and ball the ball's frames, or None if it couldn't load."""
    size, tint, ball_frame, nudge = RECALL[step]
    canvas = [b"\0" * 4 * w] * h
    if ball is not None and ball_frame is not None:
        canvas = png_place(ball[ball_frame], k, w, h, nudge * k)
    if size:
        rgb, amount = TINTS[tint]
        sw = max(1, round(len(mon[0]) // 4 * k * size))
        sh = max(1, round(len(mon) * k * size))
        mon = png_resize(png_tint(mon, rgb, amount), sw, sh)
        canvas = png_over(canvas, png_place(mon, 1, w, h))
    return canvas


def cached_png(path, url, decode):
    """decode(data) of a PNG from the disk cache, else fetched once and cached.
    Raises on any failure; the caller treats that as no sprite."""
    try:
        with open(path, "rb") as f:
            return decode(f.read())
    except Exception:
        pass  # not cached yet, or damaged: fetch it again
    import urllib.request  # here, so the hooks and --list never load it
    with urllib.request.urlopen(url, timeout=SPRITE_TIMEOUT) as r:
        data = r.read(65536)
    result = decode(data)  # cache only what decodes
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)  # whole files only: other tabs' panels read this cache too
    return result


def load_icon(dex, cache=SPRITE_DIR, url=SPRITE_URL):
    """A species' icon frames, 32x32 each."""
    return cached_png(os.path.join(cache, "%03d.png" % dex), url % DEX_NAMES[dex - 1],
                      lambda data: icon_frames(png_decode(data)))


def load_ball(cache=SPRITE_DIR, url=BALL_URL):
    """The Poké Ball's frames. Its sheet has no tRNS: as on the GBA, palette
    index 0 is the clear one."""
    return cached_png(os.path.join(cache, "ball.png"), url,
                      lambda data: ball_frames(png_decode(data, clear=0)))


def image_escape(png, w, h):
    """An iTerm2 inline image, w x h px, at the cursor. doNotMoveCursor (a
    WezTerm extension) keeps the cursor still, so a 2-row image never scrolls
    the panel. The payload is base64 only; no transcript text goes in."""
    return ("\x1b]1337;File=inline=1;width=%dpx;height=%dpx;preserveAspectRatio=0;"
            "doNotMoveCursor=1:%s\x07" % (w, h, base64.b64encode(png).decode("ascii")))


class Sprites:
    """Each task's party icon, ready to draw. Icons (and the Poké Ball) load
    on a background thread (the disk cache, else one fetch), so a repaint
    never waits: an icon not here yet is a blank gap, and one that failed is
    asked for again after SPRITE_RETRY."""

    def __init__(self, cache=SPRITE_DIR, url=SPRITE_URL, ball_url=BALL_URL):
        self.cache, self.url, self.ball_url = cache, url, ball_url
        self.cell = (0, 0)   # a cell's pixel size at this repaint
        self.frames = {}     # dex (or BALL) -> its frames as RGBA rows (written by the thread)
        self.asked = {}      # dex (or BALL) -> when it was last queued for loading
        self.escapes = {}    # (dex, cell, pose) -> the image escape
        self.todo = queue.Queue()
        self.thread = None

    def fits(self, fd=None):
        """Measure the cells for this repaint (the font size can change);
        whether a sprite fits at all."""
        try:
            fd = sys.stdout.fileno() if fd is None else fd
        except (OSError, ValueError):
            fd = -1
        self.cell = cell_px(fd)
        return sprite_scale(*self.cell) > 0

    def escape(self, task, now):
        """The escape drawing this task's sprite as it is now (bobbing,
        standing still, or returning to its ball), filling the gutter beside
        its first 2 rows; '' until the icon has loaded."""
        dex = sprite_for(task["id"])
        frames = self.frames.get(dex)
        if frames is None:
            self.want(dex, now)
            self.want(BALL, now)  # so it's here by the time any task leaves
            return ""
        step = recall_step(task, now)
        pose = ("bob", sprite_frame(task, now)) if step is None else ("recall", step)
        key = (dex, self.cell, pose)
        esc = self.escapes.get(key)
        if esc is None:
            ball = self.frames.get(BALL)
            if step is not None and ball is None:
                self.want(BALL, now)
            esc = self.draw(frames, pose, ball)
            if step is None or ball is not None:  # drawn again once the ball loads
                self.escapes[key] = esc
        return esc

    def draw(self, frames, pose, ball):
        w, h = GUTTER * self.cell[0], 2 * self.cell[1]
        k = min(sprite_scale(*self.cell), w * 4 // len(frames[0][0]), h // len(frames[0]))
        if not k:
            return ""
        kind, n = pose
        rows = (png_place(frames[n % len(frames)], k, w, h) if kind == "bob"
                else recall_png(frames[0], ball, n, k, w, h))
        return image_escape(png_encode(rows), w, h)

    def want(self, key, now):
        if key in self.asked and now - self.asked[key] < SPRITE_RETRY:
            return  # queued already, or failed recently
        self.asked[key] = now
        if self.thread is None:
            self.thread = threading.Thread(target=self.work, daemon=True)
            self.thread.start()
        self.todo.put(key)

    def work(self):
        while True:
            self.load(self.todo.get())

    def load(self, key):
        try:
            if key == BALL:
                self.frames[key] = load_ball(self.cache, self.ball_url)
            else:
                self.frames[key] = icon_crop(load_icon(key, self.cache, self.url))
        except Exception:
            pass  # offline, a bad file, anything: no sprite, never a crash


# ---------------------------------------------------------------------------
# Drawing (plain ANSI; colours come from the terminal's palette)

RESET, BOLD, DIM, REV = "\x1b[0m", "\x1b[1m", "\x1b[2m", "\x1b[7m"
MAGENTA = "\x1b[35m"
COL = {"running": "\x1b[36m", "done": "\x1b[32m", "failed": "\x1b[31m",
       "killed": "\x1b[35m", "stale": "\x1b[33m"}
ICON = {"running": "●", "done": "✔", "failed": "✘", "killed": "■", "stale": "◌"}
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def fmt_dur(s):
    s = int(max(0, s))
    if s < 60:
        return "%ds" % s
    if s < 3600:
        return "%dm%02ds" % (s // 60, s % 60)
    return "%dh%02dm" % (s // 3600, (s % 3600) // 60)


CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def safe(text):
    """Text from transcripts and task output, with every control character
    (ESC above all) shown as '?', so nothing in it can drive the terminal:
    retitle the window, plant hyperlinks, or write the clipboard (OSC 52)."""
    return CONTROL_RE.sub("?", str(text).replace("\t", " "))


def clip(text, width):
    """Every string drawn on screen passes through here, so it is made safe here."""
    text = safe(text)
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def project_name(slug):
    """'-Users-me-repos-Momentum' -> 'repos-Momentum'; the home folder itself -> '~'.

    The slug flattens '/' to '-', so it can't tell 'hilltop-war' from
    'hilltop/war'; project_label prefers the session's real folder."""
    home = os.path.expanduser("~").replace("/", "-")
    if slug in (home, home + "-"):
        return "~"
    if slug.startswith(home + "-"):
        return slug[len(home) + 1:]
    return slug.lstrip("-") or "~"


def project_label(slug, cwd=""):
    """The session folder's name ('hilltop-war'), else a best guess from the slug."""
    if cwd:
        if os.path.realpath(cwd) == os.path.realpath(os.path.expanduser("~")):
            return "~"
        return os.path.basename(cwd.rstrip("/")) or "~"
    return project_name(slug)


def clock(epoch, seconds=False):
    """12-hour wall-clock time: '1:04 PM' (or '1:04:09 PM')."""
    return time.strftime("%I:%M:%S %p" if seconds else "%I:%M %p",
                         time.localtime(epoch)).lstrip("0")


def in_scope(tasks, session, show_all=False):
    """The tasks of one Claude session, or every task when show_all/no session."""
    if show_all or not session:
        return list(tasks)
    return [t for t in tasks if t.get("session") == session]


def busy(tasks):
    """Whether background work is running: background shells and subagents.
    Foreground commands are listed but don't widen or hold open the panel,
    so it doesn't jump around on every slow command."""
    return any(t["state"] == "running" and not t.get("foreground") for t in tasks)


def when(task, now):
    """'since 1:03 PM' while running; 'done 1:04 PM' (or failed/killed) after."""
    if task["state"] == "running":
        return "since " + clock(task["start"])
    word = {"done": "done", "failed": "failed", "killed": "killed"}.get(task["state"], "ended")
    return "%s %s" % (word, clock(task["end"] or now))


def header(tasks, width, scope, now):
    """' CLAUDE TASKS  2 running · this session            1:04 PM'"""
    running = sum(t["state"] == "running" for t in tasks)
    stale = sum(t["state"] == "stale" for t in tasks)
    head = " CLAUDE TASKS "
    summary = ("%d running" % running if running else "idle") \
        + (" · %d stale" % stale if stale else "") + (" · " + scope if scope else "")
    right = clock(now)
    summary = clip(summary, max(0, width - len(head) - len(right) - 3))
    pad = width - len(head) - 1 - len(summary) - len(right)
    return (BOLD + REV + clip(head, width) + RESET + " " + DIM + summary + RESET
            + " " * max(1, pad) + DIM + right + RESET)


def title_row(t, frame, width, now):
    """' ⠋ Run the test suite              1m04s' (a spinner while it runs)."""
    st = t["state"]
    icon = SPIN[frame % len(SPIN)] if st == "running" else ICON[st]
    right = fmt_dur((t["end"] or now) - t["start"])
    title = clip(t["description"], width - len(right) - 4)
    pad = width - len(title) - len(right) - 3
    return " %s %s%s%s" % (icon, title, " " * max(1, pad), right)


def meta_line(t, now):
    """'WezTerm-Setup · Explore · done 1:04 PM'"""
    kind = (t.get("agent_type") or "agent") if t["kind"] == "agent" else ""
    return " · ".join(p for p in (t.get("label") or project_name(t["project"]), kind,
                                  "foreground" if t.get("foreground") else "",
                                  when(t, now)) if p)


def paint(lines, sprites=()):
    """Draw lines from the top, then each sprite (row, escape) at column 1,
    as one synchronized update so nothing flickers. An image lives in the
    cells it covers: text printed there erases it, so a task's text starts
    after the gutter's spaces (which blank a gap with no sprite), the final
    erase comes below the last row, and the sprites go last."""
    out = ["\x1b[?2026h"]
    out += ["\x1b[%d;1H%s\x1b[K" % (y, l) for y, l in enumerate(lines, 1)]
    out.append("\x1b[J")
    out += ["\x1b[%d;1H%s" % (y, esc) for y, esc in sprites if esc]
    out.append("\x1b[?2026l")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def render(board, tasks, sel, width, height, frame, banner, scope="", art=None):
    now = time.time()
    gutter = GUTTER if art and art.fits() else 0
    w, ind = width - gutter, " " * gutter  # each task block sits right of its sprite
    lines, sprites = [header(tasks, width, scope, now)], []
    lines.append(DIM + "─" * width + RESET)
    if not tasks:
        lines.append(DIM + " nothing running" + RESET)
    bar_w = max(8, w - 22)
    for i, t in enumerate(tasks):
        c, st = COL[t["state"]], t["state"]
        elapsed = (t["end"] or now) - t["start"]
        if gutter and len(lines) + 2 <= height - 2:  # both its rows above the footer
            sprites.append((len(lines) + 1, art.escape(t, now)))
        lines.append(ind + (REV if i == sel else "") + c + title_row(t, frame, w, now) + RESET)
        if st == "running" and t["kind"] == "shell":
            exp = board.estimate(t["command"])
            if exp:
                frac = min(elapsed / exp, 0.99)
                fill = int(bar_w * frac)
                left = exp - elapsed
                tail_txt = ("%3d%% left ~%s" % (round(100 * (1 - frac)), fmt_dur(left))
                            if left > 0 else " overrunning")
                lines.append(ind + "   " + c + "▓" * fill + DIM + "░" * (bar_w - fill) + RESET
                             + " " + tail_txt)
            else:
                lines.append(ind + "   " + DIM + "no history yet · elapsed only" + RESET)
        elif st == "stale":
            lines.append(ind + "   " + COL["stale"] + "never finished; its shell is gone" + RESET)
        lines.append(ind + "   " + DIM + clip(meta_line(t, now), w - 3) + RESET)
        if t["detail"]:
            act = MAGENTA if st == "running" and t["kind"] == "agent" else DIM
            lines.append(ind + "   " + act + "↳ " + clip(t["detail"], w - 5) + RESET)
    lines = lines[: height - 2]
    while len(lines) < height - 2:
        lines.append("")
    lines.append(DIM + "─" * width + RESET)
    lines.append(banner or (DIM + clip(" j/k move  x kill  d clear stale  a all/this  q close", width) + RESET))
    paint(lines, sprites)


def render_strip(tasks, width, height, frame, scope="", art=None):
    """The idle strip: a header and the most recent tasks, one line each, or
    with sprites two rows each (title, then meta) beside a 2-row sprite."""
    now = time.time()
    gutter = GUTTER if art and art.fits() else 0
    w, ind = width - gutter, " " * gutter
    lines, sprites = [header(tasks, width, scope, now)], []
    if not tasks:
        lines.append(DIM + clip(" nothing running · this widens into the full panel while tasks run", width) + RESET)
    for t in tasks[: max(0, (height - 1) // (2 if gutter else 1))]:
        st = t["state"]
        if gutter:
            sprites.append((len(lines) + 1, art.escape(t, now)))
            lines.append(ind + COL[st] + title_row(t, frame, w, now) + RESET)
            lines.append(ind + "   " + DIM + clip(meta_line(t, now), w - 3) + RESET)
            continue
        icon = SPIN[frame % len(SPIN)] if st == "running" else ICON[st]
        right = "%s · %s" % (when(t, now), fmt_dur((t["end"] or now) - t["start"]))
        title = clip(t["description"], max(0, width - len(right) - 5))
        pad = width - len(title) - len(right) - 3
        lines.append(COL[st] + " %s %s%s" % (icon, title, " " * max(1, pad)) + DIM + right + RESET)
    lines = lines[:height]
    while len(lines) < height:
        lines.append("")
    paint(lines, sprites)


# ---------------------------------------------------------------------------
# Panel

def panel(mode="manual", claude=None, session=None):
    """The panel loop. mode: 'manual' (stays until q), 'auto' (full panel that
    shrinks back to the strip when idle) or 'strip' (idle strip that widens
    into 'auto' when a task starts). claude: the Claude pane it is docked to."""
    os.makedirs(STATE_DIR, exist_ok=True)
    me = os.environ.get("WEZTERM_PANE")
    tab = None
    if claude is not None:
        info = pane_info(wez_panes(), claude)
        tab = info.get("tab_id") if info else None
        if tab is not None and me:
            register(tab, me, claude, session, mode)
    title = "claude-tasks" if mode != "strip" else "claude-tasks strip"
    sys.stdout.write("\x1b]0;%s\x07\x1b[?25l\x1b[?1049h" % title)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    board, sel, frame, scans = Board(), 0, 0, 0
    art = Sprites() if sprites_enabled() else None
    show_all = not session
    idle_since, confirm, banner = None, None, ""
    try:
        everything = board.scan()
        next_scan = time.time() + REFRESH
        while True:
            tasks = in_scope(everything, session, show_all)
            scope = "" if not session else ("all sessions" if show_all else "this session")
            size = os.get_terminal_size()
            sel = max(0, min(sel, len(tasks) - 1))
            if mode == "strip":
                render_strip(tasks, size.columns, size.lines, frame, scope, art)
            else:
                render(board, tasks, sel, size.columns, size.lines, frame, banner, scope, art)
            # With sprites, wake just after the bob's next frame so each frame
            # shows for one even SPRITE_TICK; otherwise every 0.15 s.
            wait = SPRITE_TICK - time.time() % SPRITE_TICK + 0.005 if art else 0.15
            r, _, _ = select.select([sys.stdin], [], [], wait)
            frame += 1
            if r:
                ch = os.read(fd, 1).decode(errors="ignore")
                if confirm is not None:
                    if ch in "yY":
                        kill_task(confirm)
                        banner = COL["killed"] + " sent SIGTERM to " + clip(confirm["description"], 30) + RESET
                    else:
                        banner = ""
                    confirm = None
                elif ch == "q":
                    return
                elif ch == "a" and session:
                    show_all = not show_all
                elif ch in "j\x0e":
                    sel += 1
                elif ch in "k\x10":
                    sel -= 1
                elif ch == "d":
                    board.dismiss_stale(tasks)
                    next_scan = 0
                elif ch == "x" and tasks:
                    t = tasks[sel]
                    if t["state"] != "running":
                        banner = DIM + " not running" + RESET
                    elif t["kind"] == "agent":
                        banner = DIM + " agents stop from Claude (TaskStop)" + RESET
                    else:
                        confirm = t
                        banner = COL["failed"] + BOLD + " kill “%s”? y/n" % clip(t["description"], size.columns - 16) + RESET
            if time.time() < next_scan:
                continue
            everything = board.scan()
            next_scan = time.time() + REFRESH
            scans += 1
            if claude is None:
                # Undocked (plain --auto): close once idle, as before.
                if mode == "auto":
                    if busy(in_scope(everything, session)):
                        idle_since = None
                    elif idle_since is None:
                        idle_since = time.time()
                    elif time.time() - idle_since >= GRACE:
                        return
                continue
            if tab is not None and me:
                # A resumed or new Claude session in this tab re-targets the panel.
                st = load_json(tab_state(tab), {})
                if str(st.get("pane")) == str(me) and st.get("session") and st.get("session") != session:
                    session, show_all = st.get("session"), False
            if scans % PANE_CHECK == 0 and pane_info(wez_panes(), claude) is None:
                return  # the Claude pane closed; take the panel with it
            running = busy(in_scope(everything, session))
            if mode == "strip" and running:
                if open_panel(claude, "auto", session):
                    return  # the full panel took over
            elif mode == "auto":
                if running:
                    idle_since = None
                elif idle_since is None:
                    idle_since = time.time()
                elif time.time() - idle_since >= GRACE:
                    open_panel(claude, "strip", session)
                    return
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?1049l\x1b[?25h")
        sys.stdout.flush()
        if tab is not None and me:
            unregister(tab, me)


# ---------------------------------------------------------------------------
# WezTerm: finding the Claude pane, placing and tracking the panel

def first_bin(paths, fallback):
    return next((p for p in paths if os.path.exists(p)), fallback)


def socket_alive(path):
    """Whether anything accepts connections on the unix socket at `path`."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect(path)
        return True
    except OSError:
        return False
    finally:
        s.close()


def stale_socket(env):
    """Whether $WEZTERM_UNIX_SOCKET names a GUI that is gone: tmux and the daemon
    behind Claude's background jobs outlive a WezTerm restart and keep the old
    GUI's socket, which `wezterm cli` then fails on instead of finding the new one."""
    sock = env.get("WEZTERM_UNIX_SOCKET")
    return bool(sock) and not socket_alive(sock)


def cli_env(env=None):
    """The environment for `wezterm cli`: without a stale socket, so it finds
    the running GUI by itself."""
    env = dict(os.environ if env is None else env)
    if stale_socket(env):
        del env["WEZTERM_UNIX_SOCKET"]
    return env


def wez(*args):
    """Run `wezterm cli ...`; stdout, or '' on any failure."""
    try:
        return subprocess.run([first_bin(WEZTERM_BINS, "wezterm"), "cli"] + list(args),
                              capture_output=True, text=True, timeout=5, env=cli_env()).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def wez_panes():
    try:
        panes = json.loads(wez("list", "--format", "json") or "[]")
    except ValueError:
        return []
    return panes if isinstance(panes, list) else []


def pane_info(panes, pane_id):
    for p in panes:
        if str(p.get("pane_id")) == str(pane_id):
            return p
    return None


def pane_for_tty(panes, tty_name):
    for p in panes:
        if tty_name and p.get("tty_name") == tty_name:
            return p.get("pane_id")
    return None


def claude_pane(panes, env=None):
    """The WezTerm pane showing this Claude session (hooks run in its environment)."""
    env = os.environ if env is None else env
    if env.get("TMUX_PANE"):
        tmux = first_bin(TMUX_BINS, "tmux")
        try:
            session = subprocess.run([tmux, "display-message", "-p", "-t", env["TMUX_PANE"],
                                      "#{session_name}"], capture_output=True, text=True,
                                     timeout=5).stdout.strip()
            ttys = subprocess.run([tmux, "list-clients", "-t", session, "-F", "#{client_tty}"],
                                  capture_output=True, text=True, timeout=5).stdout.split()
        except (OSError, subprocess.SubprocessError):
            ttys = []
        for t in ttys:
            pane = pane_for_tty(panes, t)
            if pane is not None:
                return pane
    # A background job's $WEZTERM_PANE is where Claude's daemon started, and one
    # beside a stale socket numbers a pane of the old GUI: use the focused pane.
    trusted = not env.get("CLAUDE_JOB_DIR") and not stale_socket(env)
    if trusted and env.get("WEZTERM_PANE") and pane_info(panes, env["WEZTERM_PANE"]):
        return int(env["WEZTERM_PANE"])
    try:
        clients = json.loads(wez("list-clients", "--format", "json") or "[]")
        return clients[0].get("focused_pane_id") if clients else None
    except (ValueError, AttributeError):
        return None


def placement(cols, mode):
    """(direction, cells) for a panel beside a Claude pane `cols` wide.

    The strip and the narrow-window panel take rows, never columns, so Claude
    keeps its width and its diff panel (>= 144 columns) keeps opening."""
    if mode == "strip":
        return ("bottom", STRIP_ROWS)
    if cols - PANEL_COLS - 1 >= MIN_CLAUDE_COLS:
        return ("right", PANEL_COLS)
    return ("bottom", PANEL_ROWS)


def tab_state(tab):
    return os.path.join(STATE_DIR, "tab-%s.json" % tab)


def register(tab, pane, claude, session, mode):
    save_json(tab_state(tab), {"pane": int(pane), "claude_pane": int(claude),
                               "session": session or "", "mode": mode})


def unregister(tab, pane):
    """Forget this tab's panel, unless another panel already took over."""
    st = load_json(tab_state(tab), {})
    if str(st.get("pane")) == str(pane):
        try:
            os.remove(tab_state(tab))
        except OSError:
            pass


def live_panel(panes, tab):
    """This tab's registered panel, if its pane still exists in the tab."""
    st = load_json(tab_state(tab), {})
    info = pane_info(panes, st.get("pane"))
    return st if info and info.get("tab_id") == tab else None


def open_panel(claude, mode, session, panes=None):
    """Split a panel off the Claude pane; returns its pane id, or None."""
    panes = wez_panes() if panes is None else panes
    info = pane_info(panes, claude)
    if not info:
        return None
    direction, cells = placement((info.get("size") or {}).get("cols", 0), mode)
    args = ["split-pane", "--pane-id", str(claude), "--" + direction, "--cells", str(cells),
            "--", sys.executable, os.path.realpath(__file__), "--" + mode, "--pane", str(claude)]
    if session:
        args += ["--session", session]
    new = wez(*args).strip()
    if not new.isdigit():
        return None
    register(info.get("tab_id"), new, claude, session, mode)  # claim the tab before it starts
    wez("activate-pane", "--pane-id", str(claude))
    return int(new)


# ---------------------------------------------------------------------------
# Hooks

def read_event():
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return {}
    return event if isinstance(event, dict) else {}


def dock(event, mode):
    """Open `mode` beside this session's Claude pane unless its tab has a panel.
    A panel already there is pointed at this session instead."""
    panes = wez_panes()
    claude = claude_pane(panes)
    info = pane_info(panes, claude) if claude is not None else None
    if not info:
        return
    session = event.get("session_id") or ""
    st = live_panel(panes, info.get("tab_id"))
    if st:
        if session and st.get("session") != session:
            st["session"] = session
            save_json(tab_state(info.get("tab_id")), st)
        return  # an idle strip widens by itself within a couple of seconds
    open_panel(claude, mode, session, panes)


def hook():
    """PostToolUse: a background shell or subagent just started."""
    event = read_event()
    name = event.get("tool_name")
    inp = event.get("tool_input") or {}
    if name == "Bash" and not inp.get("run_in_background"):
        return
    if name not in ("Bash", "Agent"):
        return
    dock(event, "auto")


def session_start():
    """SessionStart: dock the idle strip under the Claude pane."""
    dock(read_event(), "strip")


def parse_args(argv):
    opts = {"mode": "manual", "pane": None, "session": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--auto", "--strip", "--manual", "--hook", "--session-start", "--list"):
            opts["mode"] = a[2:]
        elif a in ("--pane", "--session") and i + 1 < len(argv):
            opts[a[2:]] = argv[i + 1]
            i += 1
        i += 1
    return opts


def listing():
    board = Board()
    for t in board.scan():
        exp = board.estimate(t["command"]) if t["kind"] == "shell" else None
        print("%-8s %-6s %-18s %s%s" % (
            t["state"], t["kind"], safe(t["id"]), safe(t["description"]),
            "  (~%s expected)" % fmt_dur(exp) if exp else ""))


if __name__ == "__main__":
    opts = parse_args(sys.argv[1:])
    if opts["mode"] == "hook":
        hook()
    elif opts["mode"] == "session-start":
        session_start()
    elif opts["mode"] == "list":
        listing()
    else:
        panel(opts["mode"], opts["pane"], opts["session"])
