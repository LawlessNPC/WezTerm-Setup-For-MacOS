#!/usr/bin/env python3
"""claude-tasks: a WezTerm panel for Claude Code's background tasks.

One panel per WezTerm tab, docked to the Claude pane, in two shapes:
- a compact strip along the bottom while nothing runs (rows only, so Claude's
  pane keeps its width and the built-in diff panel, which needs >= 144
  columns, keeps opening), and
- a full panel while tasks run: on the right when Claude still keeps
  MIN_CLAUDE_COLS columns, otherwise taller along the bottom.
It switches shape on its own, focuses on the Claude session that opened it
(`a` toggles every session), and closes when the Claude pane closes.

    claude-tasks                   the panel, all sessions; stays until q
    claude-tasks --manual --pane N the same, docked to pane N (Cmd+Shift+B)
    claude-tasks --strip --pane N  the idle strip; widens into --auto when a
                                   task starts
    claude-tasks --auto --pane N   the full panel; shrinks back to the strip
                                   once nothing is running
    claude-tasks --session-start   SessionStart hook: opens the strip beside
                                   the Claude pane if its tab has no panel
    claude-tasks --hook            PostToolUse hook: opens the full panel when
                                   a background task starts and the tab has no
                                   panel (a strip upgrades itself)
    claude-tasks --list            one-shot plain listing (for debugging)

Hooks run in Claude's environment. Inside tmux, $WEZTERM_PANE is whichever
pane started the tmux server, so the Claude pane is found by mapping
$TMUX_PANE -> its tmux session's attached client tty -> the WezTerm pane on
that tty. A background job runs in Claude's daemon, whose $WEZTERM_PANE is the
pane the daemon started in, and a shell that outlived a WezTerm restart names
the old GUI's socket and pane; both dock beside the focused pane instead, and
`wezterm cli` drops a dead socket so it finds the running GUI.

Where the facts come from:
- Claude Code writes each background shell's output to
  $TMPDIR-ish /private/tmp/claude-<uid>/<project>/<session>/tasks/<id>.output and
  appends "[exited with code N]" (or "[killed]") when it ends. While it runs, its
  shell holds that file open, so `lsof` says which tasks are alive and their pids.
- Subagents get <id>.output as a symlink to their transcript; they are done once
  the parent session's transcript carries a <task-notification> for that id.
- Descriptions and commands come from the session transcript
  (~/.claude/projects/<project>/<session>.jsonl), read incrementally.
- "% left" is an estimate: elapsed time against the median of the last five
  successful runs of the same command (or the sum of its parts, e.g.
  `make check` + `make test-watch`), measured from finished tasks' output files.

Each task also gets a Gen 3 Pokémon party-menu icon, picked from its id so it
stays the same: it bobs while the task runs, stands still once it ends, and
returns to its Poké Ball just before the finished task leaves the list. The
icons (and the ball) come from pret/pokeemerald, fetched on first use into
~/.cache/claude-tasks/sprites/ (never into the repo), and are drawn with the
iTerm2 image protocol. CLAUDE_TASKS_SPRITES=0 turns them off; outside WezTerm
they are off.

Python 3.9 compatible (the system python3), stdlib only.
"""
import base64
import calendar
import fcntl
import glob
import json
import os
import queue
import re
import select
import signal
import socket
import statistics
import struct
import subprocess
import sys
import termios
import threading
import time
import tty
import zlib

UID = os.getuid()
TASK_GLOB = "/private/tmp/claude-%d/*/*/tasks/*.output" % UID
PROJECTS = os.path.expanduser("~/.claude/projects")
STATE_DIR = os.path.expanduser("~/.local/state/claude-tasks")
DISMISSED = os.path.join(STATE_DIR, "dismissed.json")
SPRITE_DIR = os.path.expanduser("~/.cache/claude-tasks/sprites")
POKEEMERALD = ("https://raw.githubusercontent.com/pret/pokeemerald/"
               "731ad5bfd6e6f265508d0efcca0ba42f9dcf5881/graphics/")
SPRITE_URL = POKEEMERALD + "pokemon/%s/icon.png"
BALL_URL = POKEEMERALD + "balls/poke.png"

REFRESH = 2.0            # seconds between redraws
GRACE = 8.0              # --auto: seconds the final state stays up before shrinking
RECENT = 24 * 3600       # finished/stale tasks older than this are not listed
HISTORY_AGE = 30 * 86400 # finished tasks younger than this feed the estimates
DONE_FADE = 180          # finished tasks drop off the list after this long
AGENT_IDLE_STALE = 3600  # an agent with no completion and no writes this long is stale
PANE_CHECK = 5           # scans between checks that the Claude pane still exists
RESUME_SLACK = 10        # agent log writes this long after its notification mean it was resumed

STRIP_ROWS = 5           # the idle strip under the Claude pane
PANEL_COLS = 60          # the full panel's width on the right
PANEL_ROWS = 14          # the full panel's height when the window is too narrow
MIN_CLAUDE_COLS = 150    # Claude's diff panel needs >= 144 columns; keep a margin

GUTTER = 5               # columns left of each task for its sprite (2 rows tall)
ICON_PX = 32             # a party icon is 32x32 frames, stacked
SHOWN_W, SHOWN_H = 32, 24  # the most any of the 386 icons draws in, both frames together
SPRITE_TICK = 0.18       # seconds per frame of the bob (the game: ~0.1 at full HP)
SPRITE_TIMEOUT = 5       # seconds to fetch one icon
SPRITE_RETRY = 600       # an icon that failed to load is asked for again after this
BALL_PX = 16             # the Poké Ball sheet is 16x16 frames, stacked
RECALL_LEAD = 3.0        # a finished task's Pokémon returns to its ball this long before it goes

WEZTERM_BINS = ("/opt/homebrew/bin/wezterm", "/usr/local/bin/wezterm",
                "/Applications/WezTerm.app/Contents/MacOS/wezterm")
TMUX_BINS = ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux")

EXIT_RE = re.compile(r"\[exited with code (-?\d+)\]\s*$")
BG_RE = re.compile(r"Command running in background with ID: ([A-Za-z0-9]+)")
AGENT_RE = re.compile(r"agentId: ([A-Za-z0-9]+)")
DETACHED = "[process exited while detached"
NOTE_RE = re.compile(r"<task-id>([A-Za-z0-9]+)</task-id>.*?<status>(\w+)</status>", re.S)
RESUME_RE = re.compile(r'"resumedAgentId"\s*:\s*"([A-Za-z0-9]+)"')
STEP_RE = re.compile(
    r"\bmake(?:\s+-C\s+\S+)?\s+[A-Za-z][\w-]*"
    r"|\bxcodebuild\b[^;&|]*?-scheme\s+\S+[^;&|]*?\b(?:test|build|archive)\b"
    r"|\bswift\s+(?:build|test)\b"
    r"|\b(?:npm|pnpm|yarn)\s+(?:run\s+)?[\w:-]+"
    r"|\bcargo\s+\w+|\bpytest\b|\bgo\s+test\b"
)


# ---------------------------------------------------------------------------
# Command keys for the duration history

def steps(command):
    """The recognisable build/test steps of a command, in order."""
    out = []
    for m in STEP_RE.finditer(command or ""):
        s = re.sub(r"\s+", " ", m.group(0)).strip()
        s = re.sub(r"-destination\s+'[^']*'", "", s)
        s = re.sub(r"-derivedDataPath\s+\S+", "", s)
        s = re.sub(r"\s+", " ", s)
        out.append(s)
    return out


def command_key(command):
    """One key per kind of command: its steps, or the command with paths blanked."""
    st = steps(command)
    if st:
        return " ; ".join(st)
    c = re.sub(r"(?:^|&&|;)\s*cd\s+\S+\s*(?:&&|;)", " ", command or "")
    c = re.sub(r"\d?>>?\s*\S+", "", c)
    c = re.sub(r"(?:~|/)[^\s'\"]*", "<path>", c)
    return re.sub(r"\s+", " ", c).strip()[:160]


# ---------------------------------------------------------------------------
# Transcript reading (incremental)

class Transcript:
    """What one session transcript says about its background tasks."""

    def __init__(self, path):
        self.path = path
        self.offset = 0
        self.uses = {}      # tool_use_id -> {"description", "command", "kind"}
        self.task_use = {}  # task id -> tool_use_id
        self.notes = {}     # task id -> last notification status
        self.note_times = {}  # task id -> when that notification arrived (epoch)
        self.resumes = {}   # agent id -> when the session last resumed it (epoch)
        self.pending = {}   # foreground Bash tool_use_id -> description, until its result
        self.cwd = ""       # the folder the session started in, for its project label
        self.ts = None      # timestamp of the record being read

    def refresh(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return
        if size < self.offset:
            self.__init__(self.path)
        if size == self.offset:
            return
        with open(self.path, "rb") as f:
            f.seek(self.offset)
            data = f.read()
        end = data.rfind(b"\n")
        if end < 0:
            return
        self.offset += end + 1
        for raw in data[: end + 1].splitlines():
            if (b'"Bash"' not in raw and b'"tool_result"' not in raw
                    and b"run_in_background" not in raw and b'"Agent"' not in raw
                    and b"background with ID" not in raw and b"agentId:" not in raw
                    and b"task-notification" not in raw and b"resumedAgentId" not in raw):
                continue
            try:
                self.take(json.loads(raw))
            except ValueError:
                continue

    def take(self, rec):
        if not self.cwd and isinstance(rec.get("cwd"), str):
            self.cwd = rec["cwd"]
        self.ts = parse_ts(rec.get("timestamp"))
        msg = rec.get("message") or {}
        content = msg.get("content")
        if isinstance(content, str):
            self.take_text(content)
            return
        if not isinstance(content, list):
            # Notifications that arrive while Claude is busy are stored as queued
            # commands ("attachment" / "queue-operation" records), not messages.
            self.take_text(json.dumps(rec, ensure_ascii=False))
            return
        for block in content:
            if not isinstance(block, dict):
                continue
            t = block.get("type")
            if t == "tool_use":
                name, inp = block.get("name"), block.get("input") or {}
                if name == "Bash" and not inp.get("run_in_background"):
                    self.pending[block.get("id")] = inp.get("description") or "shell command"
                elif name == "Bash":
                    self.uses[block.get("id")] = {
                        "description": inp.get("description") or "",
                        "command": inp.get("command") or "", "kind": "shell"}
                elif name == "Agent":
                    self.uses[block.get("id")] = {
                        "description": inp.get("description") or "subagent",
                        "command": "", "kind": "agent"}
            elif t == "tool_result":
                text = block.get("content")
                if isinstance(text, list):
                    text = " ".join(b.get("text", "") for b in text if isinstance(b, dict))
                text = text or ""
                self.pending.pop(block.get("tool_use_id"), None)
                m = BG_RE.search(text) or AGENT_RE.search(text)
                if m:
                    self.task_use[m.group(1)] = block.get("tool_use_id")
                r = RESUME_RE.search(text)
                if r and self.ts is not None:
                    self.resumes[r.group(1)] = self.ts  # SendMessage woke a finished agent
            elif t == "text":
                self.take_text(block.get("text") or "")

    def take_text(self, text):
        if "<task-notification>" in text:
            for m in NOTE_RE.finditer(text):
                self.notes[m.group(1)] = m.group(2)
                if self.ts is not None:
                    self.note_times[m.group(1)] = self.ts

    def info(self, task_id):
        return self.uses.get(self.task_use.get(task_id), {})


# ---------------------------------------------------------------------------
# Task discovery

def parse_ts(ts):
    """'2026-10-21T17:39:03.123Z' -> epoch seconds, or None."""
    try:
        return calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
    except (TypeError, ValueError):
        return None


def agent_state(note, note_time, resumed_at, mtime, now):
    """A subagent's state from its last notification, a later resume, and its log.

    A finished agent can be woken again (SendMessage resumes it); its old
    notification then no longer applies. That shows as a resume recorded
    after the notification, or as its log still being written well after it."""
    if note and note_time is not None:
        if (resumed_at is not None and resumed_at > note_time) or mtime > note_time + RESUME_SLACK:
            note = None
    if note == "completed":
        return "done"
    if note in ("failed", "killed", "stopped"):
        return "failed" if note == "failed" else "killed"
    if now - mtime > AGENT_IDLE_STALE:
        return "stale"
    return "running"


def tail(path, n=4096):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - n))
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def last_line(text):
    for line in reversed(text.splitlines()):
        line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line).strip()
        if line and not EXIT_RE.match(line):
            return line
    return ""


def holders(paths):
    """{path: [pid, ...]} for the files some process has open."""
    if not paths:
        return {}
    try:
        out = subprocess.run(["lsof", "-F", "pn", "--"] + list(paths),
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    res, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid is not None:
            res.setdefault(os.path.realpath(line[1:]), []).append(pid)
    return res


class Board:
    def __init__(self):
        self.transcripts = {}
        self.dismissed = set(load_json(DISMISSED, []))
        self.history = {}   # key -> [(end_time, seconds)]
        self.seen_done = set()

    def transcript(self, project, session):
        path = os.path.join(PROJECTS, project, session + ".jsonl")
        if not os.path.exists(path):
            # Entering a worktree moves the transcript into the worktree's project
            # folder; the session's task files stay under the project it began in.
            moved = glob.glob(os.path.join(PROJECTS, "*", session + ".jsonl"))
            if moved:
                path = moved[0]
        t = self.transcripts.get(path)
        if t is None:
            t = self.transcripts[path] = Transcript(path)
        t.refresh()
        return t

    def scan(self):
        now = time.time()
        files, seen = [], {}
        for path in sorted(glob.glob(TASK_GLOB), key=lambda p: os.path.islink(p)):
            real = os.path.realpath(path)
            try:
                st = os.stat(real)
            except OSError:
                continue
            if now - st.st_mtime > HISTORY_AGE:
                continue
            agent = real.endswith(".jsonl")
            parts = path.split(os.sep)
            where = (parts[-4], parts[-3])
            if real in seen:
                seen[real][4].append(where)  # the same task, re-linked by a resumed session
                continue
            entry = (real, st, agent, st.st_mtime, [where])
            seen[real] = entry
            files.append(entry)

        open_candidates = []
        for path, st, link, mtime, _ in files:
            if not link:
                t = tail(path, 200)
                if not (EXIT_RE.search(t) or "[killed]" in t or DETACHED in t):
                    open_candidates.append(path)
        held = holders(open_candidates)

        tasks = []
        for path, st, link, mtime, places in files:
            name = os.path.basename(path)
            task_id = re.sub(r"^agent-|\.(output|jsonl)$", "", name)
            info, tr = {}, None
            for project, session in reversed(places):
                cand = self.transcript(project, session)
                if tr is None or cand.notes.get(task_id):
                    tr = cand
                if not info:
                    info = cand.info(task_id)
            project, session = places[-1]
            start = getattr(st, "st_birthtime", st.st_ctime)
            meta = agent_meta(path) if link else {}
            task = {"id": task_id, "project": project, "session": session,
                    "label": project_label(project, tr.cwd if tr else ""),
                    "path": path, "start": start, "end": None, "pids": [],
                    "kind": "agent" if link else "shell",
                    "agent_type": meta.get("agentType", ""),
                    "description": info.get("description") or meta.get("description") or task_id,
                    "command": info.get("command", ""), "detail": ""}
            if link:
                task["state"] = agent_state(tr.notes.get(task_id), tr.note_times.get(task_id),
                                            tr.resumes.get(task_id), mtime, now)
                if task["state"] != "running":
                    task["end"] = mtime
                task["detail"] = agent_detail(path)
            else:
                text = tail(path)
                m = EXIT_RE.search(text)
                if m:
                    task["state"] = "done" if m.group(1) == "0" else "failed"
                    task["code"] = int(m.group(1))
                    task["end"] = mtime
                elif "[killed]" in text:
                    task["state"], task["end"] = "killed", mtime
                elif DETACHED in text:
                    task["state"], task["end"] = "done", mtime
                elif path in held:
                    task["state"] = "running"
                    task["pids"] = held[path]
                else:
                    task["state"], task["end"] = "stale", mtime
                task["detail"] = last_line(text)
                if task["state"] == "done" and task["command"] and task_id not in self.seen_done:
                    self.seen_done.add(task_id)
                    self.history.setdefault(command_key(task["command"]), []).append(
                        (mtime, mtime - start))
            if task["kind"] == "shell" and not info:
                if task["state"] == "running" and tr is not None and tr.pending:
                    task["description"] = list(tr.pending.values())[-1]
                    task["foreground"] = True
                elif task["state"] == "running" and now - start < 5:
                    continue
                if task["state"] == "running" and now - start < 5:
                    continue
            tasks.append(task)

        shown = []
        for t in tasks:
            if t["state"] == "running":
                shown.append(t)
            elif t["state"] == "stale":
                if t["id"] not in self.dismissed and now - t["end"] < RECENT:
                    shown.append(t)
            elif now - (t["end"] or 0) < DONE_FADE:
                shown.append(t)
        shown.sort(key=lambda t: (t["state"] != "running", -t["start"]))
        return shown

    def estimate(self, command):
        """Expected seconds for a command, or None."""
        def median_of(key):
            runs = sorted(self.history.get(key, []))[-5:]
            return statistics.median(s for _, s in runs) if runs else None
        whole = median_of(command_key(command))
        if whole:
            return whole
        parts = steps(command)
        if len(parts) > 1:
            meds = [median_of(p) for p in parts]
            if all(meds):
                return sum(meds)
        return None

    def dismiss_stale(self, tasks):
        for t in tasks:
            if t["state"] == "stale":
                self.dismissed.add(t["id"])
        save_json(DISMISSED, sorted(self.dismissed))


DETAIL_KEYS = ("description", "file_path", "command", "url", "pattern", "query", "prompt", "path")


def describe_tool(block):
    """'Read: main.gd', 'WebFetch: https://…', or just the tool name."""
    name = block.get("name") or "?"
    inp = block.get("input") or {}
    for key in DETAIL_KEYS:
        val = inp.get(key)
        if isinstance(val, str) and val.strip():
            val = val.strip().splitlines()[0]
            if key == "file_path":
                val = os.path.basename(val)
            return "%s: %s" % (name, val)
    return name


def agent_detail(path):
    """What the subagent is doing now: its latest tool call, or thinking/writing."""
    for line in reversed(tail(path, 65536).splitlines()):
        if '"assistant"' not in line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") != "assistant":
            continue
        for b in reversed((rec.get("message") or {}).get("content") or []):
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_use":
                if "Handback" in (b.get("name") or ""):
                    return "handed back its report"  # the agent's final act
                return describe_tool(b)
            if b.get("type") == "text" and (b.get("text") or "").strip():
                return "writing: " + b["text"].strip().splitlines()[0]
            if b.get("type") == "thinking":
                return "thinking…"
    return ""


def agent_meta(path):
    """The agent's sidecar (agentType, description) next to its transcript."""
    if not path.endswith(".jsonl"):
        return {}
    meta = load_json(path[: -len(".jsonl")] + ".meta.json", {})
    return meta if isinstance(meta, dict) else {}


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(value, f)


# ---------------------------------------------------------------------------
# Killing

def kill_task(task):
    """SIGTERM the task's process groups; never Claude's own group."""
    mine = {os.getpgid(0)}
    for pid in task["pids"]:
        try:
            pgid = os.getpgid(pid)
            parent_pgid = os.getpgid(int(subprocess.run(
                ["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True,
                text=True).stdout.strip() or 1))
        except (OSError, ValueError):
            continue
        if pgid in mine or pgid == parent_pgid:
            os.kill(pid, signal.SIGTERM)  # shares a group with its parent: just it
        else:
            os.killpg(pgid, signal.SIGTERM)


